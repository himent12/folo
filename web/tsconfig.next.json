{
  // The fw app (next.html) and the framework: JSX compiled by framework/compiler, typed by framework/jsx.d.ts.
  // tsconfig.json stays the Svelte app's (svelte-check); this one is checked with `npx tsc -p tsconfig.next.json`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "fw": ["./framework/runtime/index.ts"],
      "fw/*": ["./framework/runtime/*"]
    }
  },
  "include": ["framework/jsx.d.ts", "framework/icons.d.ts", "framework/runtime/**/*.ts", "framework/runtime/**/*.tsx", "framework/testing.ts", "framework/parity/**/*.tsx", "framework/bench/**/*.tsx", "src/**/*.tsx", "src/main.tsx"],
  "exclude": ["framework/compiler/**", "**/*.svelte.ts"]
}
