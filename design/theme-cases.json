    {"what": "raw: name and description trimmed of Unicode white space", "text": "{\"folo_theme\": 1, \"id\": \"x\", \"name\": \"\u3000 Bee\u00a0\u2003\", \"mode\": \"dark\", \"description\": \"\u0085 Hi \u2028\"}", "expect": {"base": "dark", "name": "Bee", "description": "Hi", "color": {}}}
