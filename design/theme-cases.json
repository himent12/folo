    { "what": "series entry bad", "theme": { "folo_theme": 1, "id": "x", "name": "X", "mode": "light", "color": { "chart": { "text": ["#066EA7", "#945B00", "purple", "#087568", "#6F52CF", "#AC4C07"] } } }, "error": "color.chart.text.2: not a #RRGGBB or #RRGGBBAA colour" },
    { "what": "area_opacity above 1", "theme": { "folo_theme": 1, "id": "x", "name": "X", "mode": "dark", "color": { "chart": { "area_opacity": 1.5 } } }, "error": "color.chart.area_opacity: must be a number from 0 to 1" },
    { "what": "area_opacity negative", "theme": { "folo_theme": 1, "id": "x", "name": "X", "mode": "dark", "color": { "chart": { "area_opacity": -0.1 } } }, "error": "color.chart.area_opacity: must be a number from 0 to 1" },
