{
  "$comment": "FOLO design tokens: the single source of truth for FOLO Studio (web/) and FOLO Desktop (apps/desktop/). Colours are #RRGGBB or #RRGGBBAA. Sizes are px. Durations are ms. Easing is cubic-bezier control points [x1, y1, x2, y2]. See design/README.md.",
  "version": 1,

  "font": {
    "sans": {
      "family": "Geist",
      "fallback": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"],
      "weights": [400, 500, 600],
      "files": { "400": "fonts/Geist-Regular", "500": "fonts/Geist-Medium", "600": "fonts/Geist-SemiBold" }
    },
    "mono": {
      "family": "Geist Mono",
      "fallback": ["ui-monospace", "SF Mono", "Cascadia Mono", "Consolas", "monospace"],
      "weights": [400, 500, 600],
      "files": { "400": "fonts/GeistMono-Regular", "500": "fonts/GeistMono-Medium", "600": "fonts/GeistMono-SemiBold" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "features": { "numeric": "tnum", "$comment": "Metric values always use tabular numerals (tnum) so columns and ticking counters do not jitter." }
  },

  "type": {
    "$comment": "size / line height in px, tracking in em, weight is the default for that step.",
    "micro": { "size": 10, "line": 12, "tracking": 0.06, "weight": 500, "$comment": "only label chips drawn on images and keycaps' secondary marks" },
    "xs": { "size": 11, "line": 16, "tracking": 0.01, "weight": 400, "$comment": "only chart tick labels" },
    "$floor": "Text is at least sm (12 px); see design/README.md, Type.",
    "sm": { "size": 12, "line": 16, "tracking": 0, "weight": 400 },
    "base": { "size": 13, "line": 20, "tracking": 0, "weight": 400, "$comment": "default UI text" },
    "md": { "size": 14, "line": 20, "tracking": -0.005, "weight": 400 },
    "lg": { "size": 16, "line": 24, "tracking": -0.01, "weight": 500 },
    "xl": { "size": 20, "line": 28, "tracking": -0.015, "weight": 600, "$comment": "page titles" },
    "2xl": { "size": 24, "line": 32, "tracking": -0.02, "weight": 600 },
    "3xl": { "size": 32, "line": 40, "tracking": -0.025, "weight": 600, "$comment": "headline metrics" },
    "4xl": { "size": 44, "line": 48, "tracking": -0.03, "weight": 600, "$comment": "hero metric" }
  },

  "space": { "0": 0, "px": 1, "0.5": 2, "1": 4, "1.5": 6, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },

  "radius": { "xs": 3, "sm": 4, "md": 6, "lg": 8, "xl": 12, "full": 9999 },

  "size": {
    "$comment": "Component metrics shared by both apps.",
    "control": { "xs": 20, "sm": 24, "md": 28, "lg": 32, "xl": 40 },
    "icon": { "sm": 14, "md": 16, "lg": 20 },
    "sidebar": 232,
    "sidebar_collapsed": 56,
    "topbar": 48,
    "row": 36,
    "row_dense": 28,
    "hairline": 1,
    "focus_ring": 2,
    "focus_offset": 2,
    "box_stroke": 2,
    "box_halo": 1,
    "content_max": 1200
  },

  "layout": {
    "$comment": "Per-app layout limits, each app's own so a change for one can't break the other. size.content_max is Studio's (the web) content column; desktop_content_max is FOLO Desktop's (a native window, wider tables and side-by-side panels). desktop_resize_edge is the band along the top of Desktop's custom title bar that resizes the window instead of dragging it (about the Windows sizing frame). desktop_caption_button is the width of each of its Minimize, Maximize and Close buttons (Windows 11's own).",
    "desktop_content_max": 1440,
    "desktop_resize_edge": 4,
    "desktop_caption_button": 46
  },

  "breakpoint": {
    "$comment": "Viewport tiers, min widths in px: phone < tablet (768) < laptop (1024) < desktop (1280, designed at 1440). Media queries use only these boundaries: (min-width: N) or (max-width: N - 1). See design/README.md, Layout tiers.",
    "tablet": 768,
    "laptop": 1024,
    "desktop": 1280
  },

  "motion": {
    "duration": { "instant": 80, "fast": 120, "base": 160, "slow": 200, "chart": 240 },
    "easing": {
      "out": [0.16, 1, 0.3, 1],
      "standard": [0.2, 0, 0, 1],
      "in": [0.4, 0, 1, 1],
      "linear": [0, 0, 1, 1]
    },
    "$comment": "No bounce, no overshoot. Enter with `out`, move with `standard`, exit with `in`. With reduced motion every duration becomes 0 except opacity fades, which drop to `instant`."
  },

  "z": { "base": 0, "sticky": 10, "sidebar": 20, "overlay": 40, "dialog": 50, "palette": 60, "toast": 70, "tooltip": 80 },

  "color": {
    "dark": {
      "bg": {
        "app": "#08090B",
        "panel": "#0E1013",
        "raised": "#14171B",
        "overlay": "#181B20",
        "inset": "#050607",
        "hover": "#FFFFFF0A",
        "active": "#FFFFFF12",
        "selected": "#C5F82A14",
        "scrim": "#000000A6"
      },
      "line": {
        "subtle": "#FFFFFF0D",
        "default": "#FFFFFF17",
        "strong": "#FFFFFF29",
        "control": "#FFFFFF59"
      },
      "text": {
        "primary": "#EDEFF2",
        "secondary": "#A1A7B0",
        "tertiary": "#80868F",
        "disabled": "#484D55",
        "inverse": "#0A0B0D"
      },
      "accent": {
        "solid": "#C5F82A",
        "solid_hover": "#D3FB5A",
        "on": "#0B0E03",
        "text": "#C5F82A",
        "line": "#C5F82A",
        "muted": "#C5F82A1F"
      },
      "success": { "solid": "#34D399", "text": "#4ADEA8", "muted": "#34D3991F" },
      "warning": { "solid": "#FFB547", "text": "#FFC266", "muted": "#FFB5471F" },
      "danger": { "solid": "#FF5C5C", "text": "#FF7A7A", "muted": "#FF5C5C1F", "fill": "#FF5C5C", "fill_hover": "#FF7A7A" },
      "info": { "solid": "#5BA8FF", "text": "#7DB9FF", "muted": "#5BA8FF1F" },
      "window": { "close": "#C42B1C", "close_text": "#FFFFFF" },
      "focus": "#C5F82A",
      "chart": {
        "series": ["#5CC8FF", "#F2C14E", "#E879F9", "#2DD4BF", "#A78BFA", "#FB923C"],
        "fill": ["#5CC8FF", "#F2C14E", "#E879F9", "#2DD4BF", "#A78BFA", "#FB923C"],
        "text": ["#5CC8FF", "#F2C14E", "#E879F9", "#2DD4BF", "#A78BFA", "#FB923C"],
        "grid": "#FFFFFF0F",
        "axis": "#FFFFFF24",
        "label": "#80868F",
        "cursor": "#FFFFFF4D",
        "swatch_edge": "#FFFFFF1F",
        "context": "#646A73",
        "area_opacity": 0.14
      }
    },
    "light": {
      "bg": {
        "app": "#F4F5F7",
        "panel": "#FFFFFF",
        "raised": "#F8F9FA",
        "overlay": "#FFFFFF",
        "inset": "#ECEEF1",
        "hover": "#0A0E140A",
        "active": "#0A0E1412",
        "selected": "#7AA80014",
        "scrim": "#0A0E1466"
      },
      "line": {
        "subtle": "#0A0E1410",
        "default": "#0A0E141C",
        "strong": "#0A0E1430",
        "control": "#0A0E1474"
      },
      "text": {
        "primary": "#0C0E12",
        "secondary": "#4F5661",
        "tertiary": "#646B75",
        "disabled": "#B3B8BF",
        "inverse": "#FFFFFF"
      },
      "accent": {
        "solid": "#BEF01E",
        "solid_hover": "#B0E50A",
        "on": "#0B0E03",
        "text": "#4A7500",
        "line": "#679400",
        "muted": "#86B80024"
      },
      "success": { "solid": "#0F9B6B", "text": "#0A724F", "muted": "#0F9B6B1A" },
      "warning": { "solid": "#BD7800", "text": "#8C5800", "muted": "#BD78001F" },
      "danger": { "solid": "#E0383E", "text": "#BB282E", "muted": "#E0383E1A", "fill": "#D52F36", "fill_hover": "#BE222B" },
      "info": { "solid": "#1F7FE0", "text": "#1664B5", "muted": "#1F7FE01A" },
      "window": { "close": "#C42B1C", "close_text": "#FFFFFF" },
      "focus": "#679400",
      "chart": {
        "series": ["#0A8FD6", "#AD6C00", "#C026D3", "#0B8A7B", "#7C5CE6", "#D9620B"],
        "fill": ["#5CC8FF", "#F2C14E", "#E879F9", "#2DD4BF", "#A78BFA", "#FB923C"],
        "text": ["#066EA7", "#945B00", "#AE21BF", "#087568", "#6F52CF", "#AC4C07"],
        "grid": "#0A0E140F",
        "axis": "#0A0E1429",
        "label": "#646B75",
        "cursor": "#0A0E1440",
        "swatch_edge": "#0A0E1438",
        "context": "#80868F",
        "area_opacity": 0.12
      }
    }
  },

  "themes": {
    "$comment": "Named colour themes (design/THEMES.md). Each is a mode (dark or light) and a palette: its mode's base colours (color.dark or color.light) with the theme's own `color` overrides merged over them key by key (arrays replace whole). Shadows follow the mode. The order here is the order the apps list them; the first theme of each mode is that mode's default and has no overrides.",
    "dark": { "name": "Dark", "mode": "dark", "description": "FOLO's own dark: near-black neutrals.", "color": {} },
    "midnight": { "name": "Midnight", "mode": "dark", "description": "Deep blue-black surfaces with cool greys.", "color": {} },
    "dim": { "name": "Dim", "mode": "dark", "description": "Lifted charcoal surfaces, softer for long sessions.", "color": {} },
    "contrast-dark": { "name": "High contrast dark", "mode": "dark", "description": "Black surfaces, white text, strong edges.", "color": {} },
    "light": { "name": "Light", "mode": "light", "description": "FOLO's own light: white panels on light grey.", "color": {} },
    "paper": { "name": "Paper", "mode": "light", "description": "Warm off-white surfaces with warm greys.", "color": {} },
    "contrast-light": { "name": "High contrast light", "mode": "light", "description": "White surfaces, black text, strong edges.", "color": {} }
  },

  "shadow": {
    "$comment": "Each shadow is a list of layers { x, y, blur, spread, color } (px, colour hex).",
    "dark": {
      "sm": [{ "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "#00000066" }],
      "md": [
        { "x": 0, "y": 4, "blur": 12, "spread": -2, "color": "#00000080" },
        { "x": 0, "y": 0, "blur": 0, "spread": 1, "color": "#FFFFFF0F" }
      ],
      "lg": [
        { "x": 0, "y": 16, "blur": 40, "spread": -8, "color": "#000000B3" },
        { "x": 0, "y": 0, "blur": 0, "spread": 1, "color": "#FFFFFF14" }
      ]
    },
    "light": {
      "sm": [{ "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "#0A0E140F" }],
      "md": [
        { "x": 0, "y": 4, "blur": 12, "spread": -2, "color": "#0A0E141A" },
        { "x": 0, "y": 0, "blur": 0, "spread": 1, "color": "#0A0E140F" }
      ],
      "lg": [
        { "x": 0, "y": 16, "blur": 40, "spread": -12, "color": "#0A0E1438" },
        { "x": 0, "y": 0, "blur": 0, "spread": 1, "color": "#0A0E1414" }
      ]
    }
  },

  "classes": {
    "$comment": "Categorical palette for detection classes, theme independent because boxes sit on photos. Class i uses palette[i % 16]. Boxes: 2 px stroke in the class colour plus a 1 px outer halo in `halo`. Label chips: class colour fill with `chip_text`.",
    "palette": [
      "#4CC9F0", "#F72585", "#FFB703", "#80ED99",
      "#9D7CFF", "#FF7B39", "#2EC4B6", "#E45CFF",
      "#F2F2F2", "#5B8CFF", "#FFD166", "#FF5D8F",
      "#3DDC97", "#FF4D4D", "#A0C4FF", "#FFADAD"
    ],
    "chip_text": "#0A0B0D",
    "halo": "#000000A6",
    "fill_opacity": 0.12
  }
}
